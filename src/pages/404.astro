---
import BaseLayout from "../layouts/BaseLayout.astro";

const isEnglish = Astro.url.pathname.startsWith("/en/");
const language = isEnglish ? "en" : "id";
const title = isEnglish ? "Page Not Found | Ras Survey" : "Halaman Tidak Ditemukan | Ras Survey";
---

<BaseLayout
  route="/404"
  language={language}
  metadata={{
    title,
    description: isEnglish ? "The page you are looking for is not available." : "Halaman yang Anda cari tidak tersedia.",
  }}
>
  <main class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-blue-700">404</p>
    <h1 class="mt-4 text-4xl font-bold text-slate-900">{isEnglish ? "Page not found" : "Halaman tidak ditemukan"}</h1>
    <p class="mt-4 text-slate-600">
      {isEnglish ? "Sorry, the page you are looking for is not available." : "Maaf, halaman yang Anda cari tidak tersedia."}
    </p>
    <a class="mt-8 inline-flex rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white" href={isEnglish ? "/en/" : "/"}>
      {isEnglish ? "Back to home" : "Kembali ke beranda"}
    </a>
  </main>
</BaseLayout>
